{
  "_doc": "Built-in defaults. Don't edit this file: put overrides in ~/.crew/config.json (or $CREW_CONFIG), by hand or with `crew.py set-role` / `crew.py set-agent`. Your file is merged over this one key by key. An agent is backend[+provider]:model[@effort]: codex, claude, agy, opencode (opencode:<provider>/<model>), api (api:<provider>/<model>), or a command-line agent you define under backends.<name>.command. Role agents are fallback lists: the first installed candidate is used, skipping the calling agent's own vendor when another candidate is installed. A role with \"other_family\": true refuses to run on the caller's own model family unless --agent names the agent. Claude agents use full model ids, because Claude Code's short aliases can lag a release (claude 2.1.286 still maps 'haiku' to Haiku 4.5).",

  "view": "auto",
  "hold": true,
  "max_minutes": 60,
  "fact_check": true,
  "prune_scratch": true,
  "terminal": null,
  "balance_step": 0.25,
  "unknown_quota": 0.5,
  "limit_cooldown_minutes": 60,

  "backends": {
    "codex": {
      "exe": null,
      "ignore_user_config": false
    },
    "claude": {
      "exe": null
    },
    "agy": {
      "exe": null,
      "settings": "~/.gemini/antigravity-cli/settings.json"
    },
    "opencode": {
      "exe": null
    }
  },

  "models": {
    "_doc": "Models by name. Use one as --agent <name>[@effort], or say it naturally (\"gemini flash medium\"). efforts lists what the model takes; default_effort is used when none is given. For agy the effort is part of the model id ({effort}). Check what your CLIs offer with `crew.py models`.",
    "sol": {"backend": "codex", "model": "gpt-6.1-sol", "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
            "default_effort": "high", "names": ["gpt-6.1-sol", "gpt sol", "codex sol", "codex"],
            "about": "OpenAI's main Codex model: reviews and harder builds"},
    "astra": {"backend": "codex", "model": "gpt-6-astra", "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
              "default_effort": "high", "names": ["gpt-6-astra", "gpt astra", "codex astra"],
              "about": "OpenAI GPT-6 Astra: frontier reasoning, slower and dearer"},
    "luna": {"backend": "codex", "model": "gpt-6-luna", "efforts": ["low", "medium", "high", "xhigh", "max"],
             "default_effort": "medium", "names": ["gpt-6-luna", "gpt luna", "codex luna", "codex fast"],
             "about": "OpenAI GPT-6 Luna: fast and cheap; light builds, lookups"},
    "terra": {"backend": "codex", "model": "gpt-6.1-terra", "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
              "default_effort": "medium", "names": ["gpt-6.1-terra", "gpt terra", "codex terra", "terra 6.1"],
              "about": "OpenAI GPT-6.1 Terra (Oct 2026), the mid tier: about 3x faster than Sol; light builds, everyday edits"},
    "sol-6": {"backend": "codex", "model": "gpt-6-sol", "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
              "default_effort": "high", "names": ["gpt-6-sol"],
              "about": "OpenAI GPT-6 Sol: previous Sol, for comparison or when 6.1 is limited"},
    "sol-5.6": {"backend": "codex", "model": "gpt-5.6-sol", "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
                "default_effort": "high", "names": ["gpt-5.6-sol"],
                "about": "OpenAI GPT-5.6 Sol: older generation"},
    "terra-5.6": {"backend": "codex", "model": "gpt-5.6-terra", "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
                  "default_effort": "medium", "names": ["gpt-5.6-terra"],
                  "about": "OpenAI GPT-5.6 Terra: older generation"},
    "luna-5.6": {"backend": "codex", "model": "gpt-5.6-luna", "efforts": ["low", "medium", "high", "xhigh", "max"],
                 "default_effort": "medium", "names": ["gpt-5.6-luna"],
                 "about": "OpenAI GPT-5.6 Luna: older generation"},
    "opus": {"backend": "claude", "model": "claude-opus-5-5", "efforts": ["low", "medium", "high", "xhigh", "max"],
             "default_effort": "high", "names": ["claude-opus-5-5", "claude opus", "opus 5.5"],
             "about": "Anthropic's strongest everyday model: reviews, hard builds"},
    "sonnet": {"backend": "claude", "model": "claude-sonnet-5-5", "efforts": ["low", "medium", "high", "xhigh", "max"],
               "default_effort": "high", "names": ["claude-sonnet-5-5", "claude sonnet", "sonnet 5.5"],
               "about": "Anthropic mid-size model: builds"},
    "haiku": {"backend": "claude", "model": "claude-haiku-5-5", "efforts": ["low", "medium", "high", "xhigh", "max"],
              "default_effort": "medium", "names": ["claude-haiku-5-5", "claude haiku", "haiku 5.5"],
              "about": "Anthropic small model: cheap research, summaries"},
    "fable": {"backend": "claude", "model": "claude-fable-5-1", "efforts": ["low", "medium", "high", "xhigh", "max"],
              "default_effort": "high", "names": ["claude-fable-5-1", "claude fable", "fable 5.1"],
              "about": "Anthropic frontier model: the hardest problems"},
    "hydrogen": {"backend": "agy", "model": "gemini-4-hydrogen-{effort}", "efforts": ["low", "medium", "high", "xhigh"],
                 "default_effort": "medium", "names": ["gemini hydrogen", "gemini 4 hydrogen", "hydrogen 4", "gemini"],
                 "about": "Google Gemini 4 Hydrogen (succeeds 3.8 Flash, Nov 2026): fast, Google Search built in; research, light builds, second opinions"},
    "gemini-flash": {"backend": "agy", "model": "gemini-3.8-flash-{effort}", "efforts": ["low", "medium", "high"],
                     "default_effort": "medium", "names": ["gemini 3.8 flash", "flash"],
                     "about": "Google Gemini 3.8 Flash: cheapest Gemini; fallback when Hydrogen is rate-limited"},
    "argon": {"backend": "agy", "model": "gemini-4-argon-{effort}", "efforts": ["low", "medium", "high"],
              "default_effort": "medium", "names": ["gemini argon", "gemini 4 argon", "argon 4", "gemini pro", "pro"],
              "about": "Google Gemini 4 Argon, which replaced Gemini Pro: hard reasoning and reviews; own weekly quota"},
    "carbon": {"backend": "api", "model": "gemini/gemini-4-carbon", "efforts": ["low", "medium", "high"],
               "default_effort": "high", "names": ["gemini carbon", "gemini 4 carbon", "carbon 4"],
               "about": "Google Gemini 4 Carbon, Google's strongest: hardest reasoning. Gemini API only (paid key, read-only, no tools) until agy offers it"},
    "agy-opus": {"backend": "agy", "model": "claude-opus-5-5-{effort}", "efforts": ["low", "medium", "high"],
                 "default_effort": "high", "names": ["opus via agy", "antigravity opus"],
                 "about": "Claude Opus 5.5 through agy: saves your Claude plan, same model family"},
    "agy-sonnet": {"backend": "agy", "model": "claude-sonnet-5-5-{effort}", "efforts": ["low", "medium", "high"],
                   "default_effort": "high", "names": ["sonnet via agy", "antigravity sonnet"],
                   "about": "Claude Sonnet 5.5 through agy: saves your Claude plan, same model family"},
    "gpt-oss": {"backend": "agy", "model": "gpt-oss-120b-medium", "efforts": [],
                "names": ["gpt-oss-120b"],
                "about": "OpenAI's open-weight gpt-oss 120B through agy; one effort setting"}
  },

  "role_names": {"build": "implement", "build-light": "implement-light"},

  "_providers_doc": "Model APIs. api agents call them directly (api:<provider>/<model>, read-only, no tools). claude+<provider>:<model> needs anthropic_url (auth_env names the variable that carries the key, default ANTHROPIC_AUTH_TOKEN), codex+<provider>:<model> needs responses. allowed_models limits which models may be used. Keys come from the key_env variable or `crew.py set-key <provider>`. family is used when the model name doesn't say. Add your own (vLLM, LiteLLM, a company gateway) the same way.",
  "providers": {
    "openrouter": {"base_url": "https://openrouter.ai/api/v1", "key_env": "OPENROUTER_API_KEY", "anthropic_url": "https://openrouter.ai/api", "responses": true, "effort_style": "openrouter", "body": {"usage": {"include": true}}, "headers": {"X-Title": "crew"}, "quota": "openrouter"},
    "openai": {"base_url": "https://api.openai.com/v1", "key_env": "OPENAI_API_KEY", "responses": true, "effort_style": "openai", "family": "openai"},
    "anthropic": {"base_url": "https://api.anthropic.com/v1", "key_env": "ANTHROPIC_API_KEY", "family": "anthropic"},
    "gemini": {"base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "key_env": "GEMINI_API_KEY", "effort_style": "openai", "family": "google"},
    "deepseek": {"base_url": "https://api.deepseek.com/v1", "key_env": "DEEPSEEK_API_KEY", "anthropic_url": "https://api.deepseek.com/anthropic", "family": "deepseek"},
    "moonshot": {"base_url": "https://api.moonshot.ai/v1", "key_env": "MOONSHOT_API_KEY", "anthropic_url": "https://api.moonshot.ai/anthropic", "family": "moonshot"},
    "kimi": {"base_url": null, "key_env": "KIMI_API_KEY", "anthropic_url": "https://api.kimi.com/coding/", "auth_env": "ANTHROPIC_API_KEY", "family": "moonshot"},
    "zai": {"base_url": "https://api.z.ai/api/paas/v4", "key_env": "ZAI_API_KEY", "anthropic_url": "https://api.z.ai/api/anthropic", "family": "zhipu"},
    "xai": {"base_url": "https://api.x.ai/v1", "key_env": "XAI_API_KEY", "family": "xai"},
    "mistral": {"base_url": "https://api.mistral.ai/v1", "key_env": "MISTRAL_API_KEY", "family": "mistral"},
    "groq": {"base_url": "https://api.groq.com/openai/v1", "key_env": "GROQ_API_KEY"},
    "cerebras": {"base_url": "https://api.cerebras.ai/v1", "key_env": "CEREBRAS_API_KEY"},
    "together": {"base_url": "https://api.together.xyz/v1", "key_env": "TOGETHER_API_KEY"},
    "fireworks": {"base_url": "https://api.fireworks.ai/inference/v1", "key_env": "FIREWORKS_API_KEY"},
    "ollama": {"base_url": "http://localhost:11434/v1", "key_env": null, "anthropic_url": "http://localhost:11434", "responses": true},
    "lmstudio": {"base_url": "http://localhost:1234/v1", "key_env": null}
  },

  "agents": {
    "codex-strong": "codex:gpt-6.1-sol@high",
    "codex-balanced": "codex:gpt-6.1-sol@medium",
    "codex-fast": "codex:gpt-6-luna@medium",
    "codex-light": "codex:gpt-6.1-terra@medium",
    "codex-frontier": "codex:gpt-6-astra@high",
    "claude-strong": "claude:claude-opus-5-5@high",
    "claude-balanced": "claude:claude-sonnet-5-5@high",
    "claude-fast": "claude:claude-haiku-5-5@medium",
    "claude-frontier": "claude:claude-fable-5-1@high",
    "google-fast": "agy:gemini-4-hydrogen-medium",
    "google-cheap": "agy:gemini-3.8-flash-medium",
    "google-balanced": "agy:gemini-4-argon-medium",
    "google-strong": "agy:gemini-4-argon-high",
    "google-frontier": "api:gemini/gemini-4-carbon@high"
  },

  "roles": {
    "review": {
      "agent": ["codex-strong", "claude-strong", "google-strong"],
      "other_family": true,
      "mode": "review",
      "access": "verify",
      "web": false,
      "network": false,
      "about": "Code review of a diff (--target uncommitted | commit:<sha> | base:<branch>). Can build and run tests; repository changes are flagged."
    },
    "check": {
      "agent": ["codex-strong", "claude-strong", "google-strong"],
      "other_family": true,
      "access": "verify",
      "web": false,
      "network": false,
      "about": "Second opinion on a plan, claim, design or specific code. Can build and run tests to back its findings."
    },
    "implement": {
      "agent": ["codex-balanced", "claude-balanced", "google-fast"],
      "access": "write",
      "web": false,
      "network": false,
      "about": "Bounded implementation. Edits the working tree, never commits; the caller checks the result and commits."
    },
    "implement-light": {
      "agent": ["claude-fast", "codex-light", "google-fast"],
      "access": "write",
      "web": false,
      "network": false,
      "balance": true,
      "about": "Cheap mechanical work: boilerplate, fixtures, test scaffolding, docs from code."
    },
    "research": {
      "agent": ["google-fast", "google-cheap", "claude-fast", "codex-fast"],
      "access": "read",
      "web": true,
      "network": false,
      "about": "Web research and documentation lookups. Answers with sources."
    },
    "light": {
      "agent": ["claude-fast", "google-fast", "codex-fast"],
      "access": "read",
      "web": false,
      "network": false,
      "balance": true,
      "about": "Light read-only work: summarise files or logs, draft prose, simple lookups."
    }
  }
}
